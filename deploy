def sh_quote(value: str) -> str:
    """`value` as one single-quoted sh word."""
    return "'%s'" % value.replace("'", "'\"'\"'")


def launcher_text(tag: str, target: Path, prefix: Path, base_url: Optional[str], has_token: bool,
                  models: Optional[Dict[str, str]] = None, helper: bool = False,
                  provider: Optional[str] = None) -> str:
    """The claude-TAG script; with no base_url, models or helper it is the subscription launcher, unchanged."""
    d = state_dir(prefix) / "deploy"
    help_text = LAUNCHER_HELP % {"tag": tag, "target": target}
    if base_url:  # provider profiles name their provider in the help; subscription help stays as it is
        help_text = help_text.replace("\n\nUsage:", "\nProvider: %s   Base URL: %s\n\nUsage:"
                                      % (provider or "custom", base_url), 1)
    # --fable-is-opus (and the retired --fable) count anywhere before a "--"; every other argument keeps its place
    lines = ["#!/bin/sh", "%s (tag: %s)" % (LAUNCHER_MARKER, tag),
             "o=; g=; e=", "for a do", "  shift",
             '  [ -z "$e" ] && case $a in --) e=1;; --fable-is-opus) o=1; continue;; --fable) g=1; continue;; esac',
             '  set -- "$@" "$a"', "done",
             'if [ -n "$g" ]; then echo "claude-%s: --fable is now the default; use --fable-is-opus to run Fable-tier agents on Opus" >&2; fi' % tag,
             'case "$1" in',
             "-h|--help|help) cat <<'EOF'",
             help_text + "EOF",
             "  exit 0;;",
             "-v|--version)",
             "  v=$(sed -n 's/^  \"pack_version\": \"\\([^\"]*\\)\".*/\\1/p' '%s/%s' 2>/dev/null)" % (target, MANIFEST_NAME),
             "  printf 'claude-supervisor %%s (claude-%s, %%s)\\n' \"${v:-unknown}\" '%s'" % (tag, target),
             '  if command -v claude >/dev/null 2>&1; then echo "claude: $(claude --version)"; else echo "claude: not found"; fi',
             "  exit 0;;",
             "critic) shift; exec '%s/skills/supervisor-config/scripts/codex-critic' \"$@\";;" % target,
             "update|uninstall|list|status|memory)",
             "  d='%s'" % d,
             '  [ -x "$d" ] || { echo "claude-%s: $d missing; run ./deploy install from your checkout" >&2; exit 1; }' % tag,
             "  exec \"$d\" --launcher '%s' '%s' '%s' \"$@\";;" % (prefix, tag, target),
             "esac",
             "CLAUDE_CONFIG_DIR='%s'; export CLAUDE_CONFIG_DIR" % target]
    if base_url:
        lines.append("ANTHROPIC_BASE_URL=%s; export ANTHROPIC_BASE_URL" % sh_quote(base_url))
    if helper:
        # settings.json apiKeyHelper supplies the token; either variable would outrank it and never refresh
        lines.append("unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY")
    elif has_token:
        lines.append("ANTHROPIC_AUTH_TOKEN=\"$(cat '%s/token')\"; export ANTHROPIC_AUTH_TOKEN"
                     % target)
        if base_url:  # keep an inherited Anthropic key away from the provider (sent as X-Api-Key)
            lines.append("ANTHROPIC_API_KEY=''; export ANTHROPIC_API_KEY")
    if models:
        for tier in TIERS:
            var = "ANTHROPIC_DEFAULT_%s_MODEL" % tier.upper()
            lines.append("%s=%s; export %s" % (var, sh_quote(models[tier]), var))
        # the main model, which the tier variables do not remap
        lines.append("ANTHROPIC_MODEL=%s; export ANTHROPIC_MODEL" % sh_quote(models["opus"]))
    lines.append("if [ -n \"$o\" ]; then ANTHROPIC_DEFAULT_FABLE_MODEL=%s; export ANTHROPIC_DEFAULT_FABLE_MODEL; fi"
                 % sh_quote(models["opus"] if models else OPUS_MODEL))
    lines.append('command -v claude >/dev/null 2>&1 || '
                 '{ echo "claude-%s: claude not found on PATH; install Claude Code, then retry" >&2; exit 127; }' % tag)
    lines.append('exec claude "$@"')
    return "\n".join(lines) + "\n"


class DeployError(Exception):
    """Expected failure: printed without a traceback, exit code 2."""


# --------------------------------------------------------------------------- utils

def eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


def timestamp() -> str:
    return _dt.datetime.now().strftime("%Y%m%d%H%M%S")


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def atomic_write_bytes(path: Path, data: bytes, mode: Optional[int] = None) -> None:
    # Write through a symlink (e.g. a dotfiles-managed settings.json) instead of replacing it.
    real = Path(os.path.realpath(str(path)))
    real.parent.mkdir(parents=True, exist_ok=True)
    if mode is None and real.exists():
        mode = real.stat().st_mode & 0o777
    fd, tmp = tempfile.mkstemp(prefix=".tmp-" + real.name + ".", dir=str(real.parent))
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, str(real))
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def atomic_copy(src: Path, dst: Path, data: Optional[bytes] = None) -> None:
    atomic_write_bytes(dst, src.read_bytes() if data is None else data, mode=src.stat().st_mode & 0o777)


def write_json_atomic(path: Path, data: dict) -> None:
    atomic_write_bytes(path, (json.dumps(data, indent=2, ensure_ascii=False) + "\n").encode("utf-8"))


def backup_file(path: Path) -> Path:
    bak = path.with_name("%s.bak-%s" % (path.name, timestamp()))
    n = 1
    while bak.exists():
        bak = path.with_name("%s.bak-%s-%d" % (path.name, timestamp(), n))
        n += 1
    shutil.copy2(str(path), str(bak))
    return bak


def is_junk(name: str) -> bool:
    return (name in JUNK_NAMES or name.startswith(".") or name.endswith(JUNK_SUFFIXES)
            or (name.startswith("#") and name.endswith("#")))


def confirm(prompt: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise DeployError("cannot ask '%s' without a terminal; re-run with --yes" % prompt)
    return input(prompt + " [y/N] ").strip().lower() in ("y", "yes")


def confirm_typed(prompt: str, expected: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise DeployError("cannot ask '%s' without a terminal; re-run with --yes" % prompt)
    return input(prompt + " Type %s to confirm: " % expected).strip() == expected


def target_tag(args: argparse.Namespace) -> Optional[str]:
    """Profile tag, or None for --global."""
    if args.use_global:
        for name in ("tag", "target", "base_url", "token", "token_file", "provider", "token_helper") \
                + tuple("model_" + t for t in TIERS):
            if getattr(args, name, None) is not None:
                raise DeployError("--global cannot be combined with --%s" % name.replace("_", "-"))
        return None
    tag = DEFAULT_TAG if args.tag is None else args.tag
    if not re.fullmatch(r"[A-Za-z0-9_-]+", tag):
        raise DeployError("invalid tag %r (use letters, digits, '-' or '_')" % tag)
    return tag


def resolve_target(args: argparse.Namespace) -> Path:
    tag = target_tag(args)
    home = Path("~/.claude").expanduser().resolve()
    if tag is None:
        return home
    target = Path(args.target or "~/.config/claude-" + tag).expanduser().resolve()
    if target == home:
        raise DeployError("%s is the global dir; use --global" % target)
    return target


def is_launcher(path: Path) -> bool:
    try:
        with open(path, "rb") as f:
            return LAUNCHER_MARKER.encode() in f.read(256)
    except OSError:
        return False


def resolve_prefix(args: argparse.Namespace) -> Path:
    return Path(args.prefix or "~/.local").expanduser().resolve()


def check_prefix(args: argparse.Namespace, target: Path, manifest: Optional[dict]) -> None:
    """Refuse to act on an install whose manifest records a different --prefix (none recorded = ~/.local)."""
    if manifest is None:
        return
    recorded = manifest.get("prefix") or str(Path("~/.local").expanduser().resolve())
    if recorded != str(resolve_prefix(args)):
        raise DeployError("%s was installed with --prefix %s; pass --prefix %s" % (target, recorded, recorded))


def resolve_source(args: argparse.Namespace) -> Path:
    src = Path(args.source).expanduser().resolve() if args.source else REPO_ROOT / "pack"
    if not src.is_dir():
        raise DeployError("source directory not found: %s; run ./deploy from the repo checkout or pass --source DIR" % src)
    return src


# --------------------------------------------------------------------------- frontmatter

def parse_frontmatter(text: str) -> Optional[Dict[str, object]]:
    """Parse the simple YAML subset used in agent/skill frontmatter.

    Supports `key: value`, quoted scalars, inline `[a, b]` lists, `- item`
    block lists and `>` / `|` block scalars.  Returns None if there is no
    `---` fenced block at the top of the file.
    """
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        return None
    body = lines[1:end]
    result: Dict[str, object] = {}
    i = 0
    while i < len(body):
        line = body[i]
        i += 1
        if not line.strip() or line.lstrip().startswith("#") or line[:1].isspace():
            continue
        key, sep, value = line.partition(":")
        if not sep:
            continue
        key, value = key.strip(), value.strip()
        if value in ("", ">", "|", ">-", "|-", ">+", "|+"):
            block: List[str] = []
            while i < len(body) and (not body[i].strip() or body[i][:1].isspace()):
                block.append(body[i].strip())
                i += 1
            items = [b[1:].strip() for b in block if b.startswith("-")]
            if value == "" and items and len(items) == len([b for b in block if b]):
                result[key] = [_unquote(x) for x in items]
            else:
                sep_char = "\n" if value.startswith("|") else " "
                result[key] = sep_char.join(b for b in block if b).strip()
        elif value.startswith("[") and value.endswith("]"):
            result[key] = [_unquote(x.strip()) for x in value[1:-1].split(",") if x.strip()]
        else:
            result[key] = _unquote(value)
    return result


def _unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def as_list(value: object) -> List[str]:
    """Normalize a tools/skills field (comma string or list) to a list."""
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v).strip() for v in value if str(v).strip()]
    return [v.strip() for v in str(value).split(",") if v.strip()]


# --------------------------------------------------------------------------- source

def read_source_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        raise DeployError("%s: not valid UTF-8 (%s); nothing written" % (path, exc.reason))


def collect_source(source: Path) -> Dict[str, Path]:
    """Map target-relative keys (agents/x.md, skills/s/...) to source files.

    Raises DeployError listing every validation problem; nothing is written
    before this passes.
    """
    files: Dict[str, Path] = {}
    problems: List[str] = []
    agents_dir, skills_dir = source / "agents", source / "skills"
    if not agents_dir.is_dir() and not skills_dir.is_dir():
        raise DeployError("source %s has neither agents/ nor skills/" % source)

    if agents_dir.is_dir():
        for p in sorted(agents_dir.iterdir()):
            if is_junk(p.name):
                continue
            if p.is_symlink():
                problems.append("symlink not allowed: %s" % p)
                continue
            if not (p.is_file() and p.suffix == ".md"):
                continue
            fm = parse_frontmatter(read_source_text(p))
            if fm is None:
                problems.append("%s: missing --- frontmatter" % p)
                continue
            if fm.get("name") != p.stem:
                problems.append("%s: frontmatter name %r != filename %r" % (p, fm.get("name"), p.stem))
            if not str(fm.get("description") or "").strip():
                problems.append("%s: missing description" % p)
            files["agents/" + p.name] = p

    if skills_dir.is_dir():
        for sk in sorted(skills_dir.iterdir()):
            if is_junk(sk.name):
                continue
            if sk.is_symlink():
                problems.append("symlink not allowed: %s" % sk)
                continue
            if not sk.is_dir():
                continue
            skill_md = sk / "SKILL.md"
            if not skill_md.is_file():
                problems.append("%s: missing SKILL.md" % sk)
                continue
            fm = parse_frontmatter(read_source_text(skill_md))
            if fm is None:
                problems.append("%s: missing --- frontmatter" % skill_md)
                continue
            if fm.get("name") != sk.name:
                problems.append("%s: frontmatter name %r != directory %r" % (skill_md, fm.get("name"), sk.name))
            if not str(fm.get("description") or "").strip():
                problems.append("%s: missing description" % skill_md)
            for root, dirs, names in os.walk(str(sk)):
                rootp = Path(root)
                for d in list(dirs):
                    if is_junk(d):
                        dirs.remove(d)
                    elif (rootp / d).is_symlink():
                        problems.append("symlink not allowed: %s" % (rootp / d))
                        dirs.remove(d)
                dirs.sort()
                for n in sorted(names):
                    fp = rootp / n
                    if is_junk(n):
                        continue
                    if fp.is_symlink():
                        problems.append("symlink not allowed: %s" % fp)
                        continue
                    files["skills/" + fp.relative_to(skills_dir).as_posix()] = fp

    if problems:
        raise DeployError("source validation failed (nothing written):\n  " + "\n  ".join(problems))
    return files


def git_info(source: Path) -> Tuple[Optional[str], Optional[bool]]:
    try:
        head = subprocess.run(["git", "-C", str(source), "rev-parse", "HEAD"],
                              capture_output=True, text=True, timeout=10)
        if head.returncode != 0:
            return None, None
        dirty = subprocess.run(["git", "-C", str(source), "status", "--porcelain", "--", "."],
                               capture_output=True, text=True, timeout=10)
        return head.stdout.strip(), bool(dirty.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        return None, None


def git_remote(source: Path) -> Optional[str]:
    """The checkout's `origin` URL, or None when git is missing or there is no origin."""
    try:
        out = subprocess.run(["git", "-C", str(source), "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    url = (out.stdout.strip() or None) if out.returncode == 0 else None
    parts = urllib.parse.urlsplit(url) if url else None
    # Drop credentials from http(s) URLs; an ssh:// user is needed to clone and holds no secret.
    if parts and parts.scheme in ("http", "https") and "@" in parts.netloc:
        url = urllib.parse.urlunsplit(parts._replace(netloc=parts.netloc.rpartition("@")[2]))
    return url


def git_branch(source: Path) -> Optional[str]:
    """The checkout's current branch, or None when detached, not a repo, or git is missing."""
    try:
        out = subprocess.run(["git", "-C", str(source), "symbolic-ref", "-q", "HEAD"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    # The full ref, because --short gives heads/<b> when a tag has the same name.
    ref = out.stdout.strip() if out.returncode == 0 else ""
    return ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else None


def read_pack_version(source: Path) -> Optional[str]:
    """The checkout's VERSION (the file next to the pack dir), or None when there is none."""
    path = source.parent / "VERSION"
    if not path.is_file():
        return None
    return path.read_text(encoding="utf-8").strip() or None


def git_out(source: Path, *args: str) -> Optional[str]:
    """Stripped stdout of `git -C source <args>`, or None when it fails or git is missing."""
    try:
        out = subprocess.run(["git", "-C", str(source)] + list(args), capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def derive_version(source: Path) -> Optional[str]:
    """VERSION, plus build metadata on a branch checkout: `<base>+<branch>.<ahead>.g<sha>[.dirty]`.

    `base` is VERSION at the merge-base with main and `ahead` the commits since, so nothing is edited
    on rebase. Plain VERSION on main, outside git, or when there is no main to compare with."""
    plain = read_pack_version(source)
    commit, dirty = git_info(source)
    branch = git_branch(source)
    if plain is None or commit is None or branch == "main":
        return plain
    ref = next((r for r in ("refs/remotes/origin/main", "refs/heads/main")
                if git_out(source, "rev-parse", "--verify", "--quiet", r)), None)
    mb = ref and git_out(source, "merge-base", "HEAD", ref)
    ahead = mb and git_out(source, "rev-list", "--count", mb + "..HEAD")
    sha = git_out(source, "rev-parse", "--short=7", "HEAD")
    if not (ahead and sha):
        return plain
    base = git_out(source.parent, "show", mb + ":./VERSION") or plain
    label = re.sub(r"[^A-Za-z0-9.-]", "-", branch or "detached")
    return "%s+%s.%s.g%s%s" % (base, label, ahead, sha, ".dirty" if dirty else "")


def version_key(version: Optional[str]) -> Optional[Tuple[int, int, int]]:
    """(X, y, commits ahead) of an `X.y[+meta]` version, or None when it does not parse."""
    main, _, meta = (version or "").partition("+")
    m = re.fullmatch(r"(\d+)\.(\d+)", main)
    if not m:
        return None
    parts = meta.split(".")  # labels may hold dots, so read from the right
    if parts[-1] == "dirty":
        parts.pop()
    ahead = int(parts[-2]) if len(parts) >= 2 and re.fullmatch(r"g[0-9a-f]+", parts[-1]) and parts[-2].isdigit() else 0
    return int(m.group(1)), int(m.group(2)), ahead


# --------------------------------------------------------------------------- manifest / lock / settings

def manifest_path(target: Path) -> Path:
    """The manifest file to read: the new name, else the legacy one if only that exists."""
    path = target / MANIFEST_NAME
    legacy = target / LEGACY_MANIFEST_NAME
    return path if path.exists() or not legacy.exists() else legacy


def migrate_legacy(target: Path, dry_run: bool) -> None:
    new, legacy = target / MANIFEST_NAME, target / LEGACY_MANIFEST_NAME
    if not legacy.exists():
        return
    if new.exists():
        print("WARNING: both %s and %s exist; using %s" % (LEGACY_MANIFEST_NAME, MANIFEST_NAME, MANIFEST_NAME))
        return
    if dry_run:
        print("would migrate %s -> %s" % (LEGACY_MANIFEST_NAME, MANIFEST_NAME))
        return
    os.replace(str(legacy), str(new))
    print("migrated %s -> %s" % (LEGACY_MANIFEST_NAME, MANIFEST_NAME))
    # The legacy lock is only an empty flock target.
    with contextlib.suppress(OSError):
        (target / LEGACY_LOCK_NAME).unlink()


def load_manifest(target: Path) -> Optional[dict]:
    path = manifest_path(target)
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DeployError("cannot read manifest %s: %s; %s" % (path, exc, MANIFEST_RECOVERY))
    if not isinstance(data, dict) or not isinstance(data.get("files"), dict) \
            or not all(isinstance(v, dict) for v in data["files"].values()):
        raise DeployError("manifest %s is malformed (needs a 'files' object of objects); %s"
                          % (path, MANIFEST_RECOVERY))
    if data.get("version") != MANIFEST_VERSION:
        raise DeployError("manifest %s has unsupported version %r; it was written by a newer deploy, "
                          "update your checkout" % (path, data.get("version")))
    return data


@contextlib.contextmanager
def target_lock(target: Path, dry_run: bool):
    if dry_run:
        yield
        return
    target.mkdir(parents=True, exist_ok=True)
    fh = open(str(target / LOCK_NAME), "a")
    try:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise DeployError("another deploy is running against %s (lock %s is held)"
                              "; wait for it to finish, then re-run" % (target, target / LOCK_NAME))
        yield
    finally:
        fh.close()


def load_settings(target: Path) -> dict:
    """Return parsed settings.json ({} if missing). Raise DeployError if unparseable."""
    path = target / "settings.json"
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DeployError("cannot parse %s: %s; fix the JSON" % (path, exc))
    if not isinstance(data, dict):
        raise DeployError("%s is not a JSON object; fix the JSON" % path)
    return data


def save_settings(target: Path, data: dict) -> Optional[Path]:
    path = target / "settings.json"
    bak = backup_file(path) if path.exists() else None
    write_json_atomic(path, data)
    return bak


def plan_settings(args: argparse.Namespace, settings: dict, prev: dict) -> Tuple[Optional[dict], dict, str]:
    """Decide what to do with settings['agent'].

    Returns (new_settings or None if unchanged, manifest settings record, message).
    """
    managed = bool(prev.get("managed_agent_key"))
    previous = prev.get("previous_agent")
    current = settings.get("agent")
    if args.no_default_agent:
        if managed and current == DEFAULT_AGENT:
            new = dict(settings)
            if previous is None:
                new.pop("agent", None)
            else:
                new["agent"] = previous
            return new, {"managed_agent_key": False, "previous_agent": None}, \
                "restore agent to %r (--no-default-agent)" % previous
        return None, {"managed_agent_key": False, "previous_agent": None}, \
            "agent left untouched (--no-default-agent)"
    if current == DEFAULT_AGENT:
        rec = {"managed_agent_key": managed, "previous_agent": previous if managed else None}
        return None, rec, "agent already %r" % DEFAULT_AGENT
    if current is None:
        new = dict(settings)
        new["agent"] = DEFAULT_AGENT
        prev_val = previous if managed else None
        return new, {"managed_agent_key": True, "previous_agent": prev_val}, "set agent = %r" % DEFAULT_AGENT
    # Some other agent is configured (by the user, possibly after we set ours).
    if args.force_default_agent:
        new = dict(settings)
        new["agent"] = DEFAULT_AGENT
        return new, {"managed_agent_key": True, "previous_agent": current}, \
            "set agent = %r (was %r, --force-default-agent)" % (DEFAULT_AGENT, current)
    return None, {"managed_agent_key": False, "previous_agent": None}, \
        "WARNING: settings agent is %r; not changed. Re-run with --force-default-agent to set %r" \
        % (current, DEFAULT_AGENT)


def critic_rule(target: Path) -> str:
    """The one permission rule install adds: the installed codex-critic script, `review` subcommand only."""
    return "Bash(%s review *)" % target.joinpath(*CRITIC_SCRIPT)


def plan_critic_rule(settings: dict, target: Path) -> Tuple[Optional[dict], str]:
    """Add critic_rule(target) to permissions.allow. Returns (new_settings or None if present, message)."""
    rule = critic_rule(target)
    perms = settings.get("permissions")
    if perms is not None and not isinstance(perms, dict):
        raise DeployError("settings permissions is not an object; fix the JSON")
    allow = (perms or {}).get("allow")
    if allow is not None and not isinstance(allow, list):
        raise DeployError("settings permissions.allow is not a list; fix the JSON")
    if rule in (allow or []):
        return None, "permission rule for its own read-only review script already present"
    new_perms = dict(perms or {}, allow=list(allow or []) + [rule])
    return dict(settings, permissions=new_perms), "adds one permission rule for its own read-only review script"


def plan_attribution(settings: dict, prev: dict) -> Tuple[Optional[dict], dict, str]:
    """Decide what to do with settings['attribution'] commit, pr and sessionUrl (profile installs only).

    Never replaces a value the pack did not set; replaces an earlier pack commit value the pack set.
    Returns (new_settings or None, record fields, message).
    """
    attr = settings.get("attribution")
    if attr is not None and not isinstance(attr, dict):
        return None, {flag: False for _, _, flag, _ in ATTRIBUTION_KEYS}, \
            "attribution is %r; not changed" % (attr,)
    new_attr = dict(attr or {})
    rec, msgs = {}, []
    for key, value, flag, legacy in ATTRIBUTION_KEYS:
        managed = bool(prev.get(flag))
        current = new_attr.get(key)
        if current is None or (managed and current in legacy):
            new_attr[key] = value
            rec[flag] = True
            msgs.append("set attribution.%s = %r" % (key, value))
        else:
            rec[flag] = managed if current == value else False
            msgs.append("attribution.%s already %r" % (key, value) if current == value
                        else "attribution.%s is %r; not changed" % (key, current))
    if new_attr == (attr or {}):
        return None, rec, "; ".join(msgs)
    return dict(settings, attribution=new_attr), rec, "; ".join(msgs)


def plan_api_key_helper(settings: dict, prev: dict, command: Optional[str]) -> Tuple[Optional[dict], dict, str]:
    """Decide what to do with settings['apiKeyHelper'] (provider profiles; command None = no helper wanted).

    Like plan_attribution: sets the key when absent or when install set it, never replaces or removes
    a value the user set. Returns (new_settings or None, record fields, message).
    """
    current = settings.get("apiKeyHelper")
    managed = bool(prev.get("managed_api_key_helper"))
    if command is not None:
        if current == command:
            return None, {"managed_api_key_helper": managed}, "apiKeyHelper already set"
        if current is None or managed:
            return dict(settings, apiKeyHelper=command), {"managed_api_key_helper": True}, \
                "set apiKeyHelper = %r" % command
        return None, {"managed_api_key_helper": False}, \
            "WARNING: apiKeyHelper is %r (yours); not changed, so it supplies the token instead of %r" \
            % (current, command)
    if current is None:
        return None, {}, ""
    if managed:
        new = dict(settings)
        del new["apiKeyHelper"]
        return new, {"managed_api_key_helper": False}, "removed apiKeyHelper"
    return None, {"managed_api_key_helper": False}, \
        "WARNING: apiKeyHelper is %r (yours); not changed" % (current,)


# --------------------------------------------------------------------------- registry

def state_dir(prefix: Path) -> Path:
    return prefix / "state" / "claude-supervisor"


def load_registry(prefix: Path) -> Dict[str, dict]:
    """The registered installs, {resolved target: {"tag", "remote", "branch"}}; empty when there is no registry."""
    path = state_dir(prefix) / "installs.json"
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise DeployError("cannot read registry %s: %s; %s" % (path, exc, REGISTRY_RECOVERY))
    installs = data.get("installs") if isinstance(data, dict) else None
    if not isinstance(installs, dict) or data.get("version") != 1 \
            or not all(isinstance(v, dict) for v in installs.values()):
        raise DeployError("registry %s is malformed; %s" % (path, REGISTRY_RECOVERY))
    return installs


def save_registry(prefix: Path, installs: Dict[str, dict]) -> None:
    write_json_atomic(state_dir(prefix) / "installs.json", {"version": 1, "installs": installs})


def register_install(prefix: Path, target: Path, tag: Optional[str], remote: Optional[str],
                     branch: Optional[str]) -> None:
    installs = load_registry(prefix)
    installs[str(target)] = {"tag": tag, "remote": remote, "branch": branch or "main"}
    save_registry(prefix, installs)


def unregister_install(prefix: Path, target: Path) -> bool:
    installs = load_registry(prefix)
    if installs.pop(str(target), None) is None:
        return False
    save_registry(prefix, installs)
    return True


def entry_branch(entry: dict) -> str:
    """The branch an install follows on update; entries recorded before branches existed follow main."""
    return entry.get("branch") or "main"


def entry_selection(key: str, entry: dict) -> List[str]:
    """CLI arguments that select one registered install."""
    return ["--global"] if entry.get("tag") is None else ["--tag", entry["tag"], "--target", key]


def check_all_exclusive(args: argparse.Namespace) -> None:
    if args.tag is not None or args.target is not None or args.use_global:
        raise DeployError("--all cannot be combined with --tag, --target or --global")


# --------------------------------------------------------------------------- install

def prune_empty_dirs(target: Path, rel_files: List[str], dry_run: bool) -> None:
    """Remove empty directories left under skills/<name>/ after deletions."""
    stop = {target, target / "skills", target / "agents"}
    for rel in rel_files:
        d = (target / rel).parent
        while d not in stop and target in d.parents:
            if dry_run or not d.is_dir() or any(p.name not in JUNK_NAMES for p in d.iterdir()):
                break
            for p in d.iterdir():
                if p.is_dir() and not p.is_symlink():
                    shutil.rmtree(str(p))
                else:
                    p.unlink()
            d.rmdir()
            d = d.parent


def seed_profile(target: Path, dry_run: bool, provider: bool = False) -> None:
    """Copy the user's own ~/.claude items into a new profile; pack files come from install.

    A provider profile leaves out settings env ANTHROPIC_* keys and apiKeyHelper, which would outrank the launcher.
    """
    home = Path("~/.claude").expanduser()
    names = [n for n in SEED if (home / n).exists() and not (target / n).exists()]
    if not names:
        return
    if dry_run:
        print("Would seed from %s: %s" % (home, ", ".join(names)))
        return
    skip = {"skills/.trash", "skills/synced"} | set((load_manifest(home) or {}).get("files", {}))

    def ignore(d: str, entries: List[str]) -> List[str]:
        rel = os.path.relpath(d, home)
        return [e for e in entries if os.path.join(rel, e) in skip or ".bak-" in e]

    for n in names:
        try:
            if n == "settings.json":
                data = json.loads((home / n).read_text(encoding="utf-8"))
                if not isinstance(data, dict):
                    raise ValueError("not a JSON object")
                data.pop("agent", None)
                if provider:
                    data.pop("apiKeyHelper", None)
                    if isinstance(data.get("env"), dict):
                        data["env"] = {k: v for k, v in data["env"].items() if not k.startswith("ANTHROPIC_")}
                write_json_atomic(target / n, data)
            elif (home / n).is_dir():
                shutil.copytree(home / n, target / n, ignore=ignore, dirs_exist_ok=True, symlinks=True)
            else:
                shutil.copy2(home / n, target / n)
        except (OSError, ValueError, shutil.Error) as exc:
            # A partial copy would make every re-run skip this item as already seeded.
            if (target / n).is_dir():
                shutil.rmtree(str(target / n), ignore_errors=True)
            else:
                with contextlib.suppress(OSError):
                    (target / n).unlink()
            raise DeployError("cannot seed from %s: %s; fix or move that file and re-run" % (home / n, exc))
    print("Seeded from %s: %s" % (home, ", ".join(names)))


def on_path(bin_dir: Path) -> bool:
    return any(e and Path(e).expanduser().resolve() == bin_dir.resolve() for e in os.environ.get("PATH", "").split(os.pathsep))


def launcher_config_dir(launcher: Path) -> Optional[str]:
    """The CLAUDE_CONFIG_DIR an existing launcher exports, or None when it cannot be read."""
    try:
        m = re.search(r"^CLAUDE_CONFIG_DIR='(.*)'; export", launcher.read_text(encoding="utf-8", errors="replace"), re.M)
    except OSError:
        return None
    return m.group(1) if m else None


def check_helper(command: str, hint: str) -> Tuple[str, str]:
    """Run a token helper once; return (command with its program as an absolute path, the token).

    The token must be exactly one word on one line. Neither the token nor the helper's output is ever printed.
    """
    try:
        words = shlex.split(command)
    except ValueError as exc:
        raise DeployError("cannot parse token helper %r: %s" % (command, exc))
    found = shutil.which(words[0]) if words else None
    if found is None:
        raise DeployError("token helper %r not found on PATH; install it, or pass --token-helper with its path; %s"
                          % (words[0] if words else command, hint))
    resolved = " ".join(shlex.quote(w) for w in [os.path.abspath(found)] + words[1:])
    try:
        p = subprocess.run([os.path.abspath(found)] + words[1:], capture_output=True, text=True,
                           timeout=HELPER_TIMEOUT, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise DeployError("token helper %s gave no token within %d s; %s" % (resolved, HELPER_TIMEOUT, hint))
    except OSError as exc:
        raise DeployError("cannot run token helper %s: %s; %s" % (resolved, exc, hint))
    if p.returncode != 0:
        raise DeployError("token helper %s failed (exit %d); %s" % (resolved, p.returncode, hint))
    words_out = p.stdout.split()
    if len(words_out) != 1 or len(p.stdout.strip().splitlines()) != 1:
        raise DeployError("token helper %s must print just the token on one line; %s" % (resolved, hint))
    return resolved, words_out[0]


def fetch_models(url: str, bearer: Optional[str]) -> List[dict]:
    """The provider's models as [{id, name?, context_length?}], sorted by id; [] with a WARNING on any failure."""
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    if bearer:
        req.add_header("Authorization", "Bearer " + bearer)
    try:
        with urllib.request.urlopen(req, timeout=MODELS_TIMEOUT) as resp:
            items = json.loads(resp.read().decode("utf-8"))["data"]
        if not isinstance(items, list):
            raise ValueError("data is not a list")
    except urllib.error.HTTPError as exc:
        reason = "HTTP %d%s" % (exc.code, " (the provider refused the token)" if exc.code in (401, 403) else "")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        reason = str(getattr(exc, "reason", None) or exc) or type(exc).__name__
    else:
        entries = []
        for item in items:
            if not (isinstance(item, dict) and isinstance(item.get("id"), str) and item["id"]):
                continue
            entry = {"id": item["id"]}
            if isinstance(item.get("name"), str):
                entry["name"] = item["name"]
            if isinstance(item.get("context_length"), int):
                entry["context_length"] = item["context_length"]
            entries.append(entry)
        return sorted(entries, key=lambda e: e["id"])
    print("WARNING: cannot list models from %s: %s; type model ids instead" % (url, reason))
    return []


def pick_model(tier: str, entries: List[dict], default: Optional[str]) -> str:
    """Ask for one tier's model: a number from the last list, an exact id, or text that filters the ids."""
    ids = {e["id"] for e in entries}
    shown: List[str] = []
    filt = ""

    def show(text: str) -> List[str]:
        matches = [e for e in entries if text.lower() in e["id"].lower()]
        for i, e in enumerate(matches[:PICK_SHOW], 1):
            ctx = e.get("context_length")
            print("  %3d  %s%s" % (i, e["id"], "  (%d tokens)" % ctx if ctx else ""))
        if len(matches) > PICK_SHOW:
            print("  and %d more; narrow the filter" % (len(matches) - PICK_SHOW))
        return [e["id"] for e in matches[:PICK_SHOW]]

    label = "%s-tier model" % tier.capitalize()
    while True:
        answer = input("%s%s: " % (label, " [%s]" % default if default else "")).strip()
        if not answer and default:
            return default
        if answer in ("", "?"):
            if not entries:
                print("  no model list; type a model id")
                continue
            shown = show(filt)
            continue
        if answer in ids:
            return answer
        if answer.isdigit() and shown:
            n = int(answer)
            if 1 <= n <= len(shown):
                return shown[n - 1]
            print("  pick 1 to %d" % len(shown))
            continue
        if not entries:
            if any(c.isspace() for c in answer):
                print("  a model id has no spaces")
                continue
            return answer
        if any(answer.lower() in i.lower() for i in ids):
            filt = answer
            shown = show(filt)
            continue
        if any(c.isspace() for c in answer):
            print("  a model id has no spaces")
        elif confirm("%s is not in the list; use it anyway?" % answer, False):
            return answer


def choose_models(cfg: dict, flags: Dict[str, str], bearer: Optional[str], interactive: bool) -> Dict[str, str]:
    """All four tier models: flags, then the manifest's (cfg['models']), then the picker on a terminal."""
    models = dict(cfg.get("models") or {})
    models.update(flags)
    missing = [t for t in TIERS if not models.get(t)]
    if missing and not interactive:
        raise DeployError("a provider profile needs a model for every tier; pass %s (or run on a terminal to "
                          "pick from the provider's list)" % " ".join("--model-%s ID" % t for t in missing))
    if missing:
        entries = fetch_models(cfg["models_url"], bearer)
        if entries:
            known = {e["id"] for e in entries}
            for tier in TIERS:
                if models.get(tier) and tier not in missing and models[tier] not in known:
                    print("WARNING: model %s for the %s tier is not in %s" % (models[tier], tier, cfg["models_url"]))
        print("Pick a model per tier from %s: a number, an exact id, or text to filter by (? lists)"
              % (cfg["provider"] or cfg["base_url"]))
        last = None
        for tier in TIERS:
            if tier in missing:
                models[tier] = pick_model(tier, entries, last)
            last = models[tier]
    return {t: models[t] for t in TIERS}


def resolve_provider(args: argparse.Namespace, target: Path, manifest: dict, token: Optional[bytes]) -> dict:
    """The provider config this install writes: flags over the manifest (base URL set = provider profile).

    Keys: provider, base_url, auth (token|helper|None), token_helper, models_url, models. Validates the
    helper and picks missing tier models before any write; a base URL taken from the manifest never asks.
    """
    flags = {t: getattr(args, "model_" + t) for t in TIERS if getattr(args, "model_" + t, None) is not None}
    for tier, value in flags.items():
        if not value or any(c.isspace() or c in "'\"" for c in value):
            raise DeployError("invalid --model-%s %r; pass a model id" % (tier, value))
    name = getattr(args, "provider", None)
    helper_flag = getattr(args, "token_helper", None)
    if name and name not in PROVIDERS:
        raise DeployError("unknown --provider %r; use %s, or --base-url URL" % (name, ", ".join(sorted(PROVIDERS))))
    if args.base_url == "" and name:
        raise DeployError("--base-url '' clears the provider; drop --provider %s" % name)
    cleared = args.base_url == "" or name == ""
    prev = {} if cleared else manifest
    if name is None:
        name = prev.get("provider")
    name = name or None
    preset = PROVIDERS.get(name) if name else None
    if name and preset is None:
        raise DeployError("%s records unknown provider %r; pass --provider or --base-url" % (target, name))
    if args.base_url:
        base_url = args.base_url
    elif args.provider:
        base_url = prev.get("base_url") if prev.get("provider") == name and prev.get("base_url") \
            else preset["base_url"]
    else:
        base_url = prev.get("base_url")
    none = {"provider": None, "base_url": None, "auth": None, "token_helper": None, "models_url": None,
            "models": None}
    if not base_url:
        if flags or helper_flag:
            raise DeployError("--model-* and --token-helper need --provider or --base-url")
        return none
    same = prev if base_url == prev.get("base_url") else {}
    hint = preset["login"] if preset else "check the provider's login instructions"
    token_file = target / "token"
    if helper_flag:
        auth, helper = "helper", helper_flag
    elif token is not None:
        auth, helper = "token", None
    elif same.get("auth") == "helper" and same.get("token_helper"):
        auth, helper = "helper", same["token_helper"]
    elif same.get("auth") == "token" and token_file.exists():
        auth, helper = "token", None  # a recorded static token beats the preset's helper default
    elif preset and preset["auth"] == "helper":
        auth, helper = "helper", preset["helper"]
    else:
        auth, helper = ("token" if token_file.exists() else None), None
    if preset and preset["auth"] == "token" and auth is None:
        raise DeployError("--provider %s needs a token: pass --token-file PATH or --token VALUE; %s" % (name, hint))
    bearer = None
    if auth == "helper":
        helper, bearer = check_helper(helper, hint)
    elif token is not None:
        bearer = token.decode("utf-8", "replace").strip()
    elif auth == "token":
        with contextlib.suppress(OSError):
            bearer = token_file.read_text(encoding="utf-8", errors="replace").strip()
    cfg = dict(none, provider=name, base_url=base_url, auth=auth, token_helper=helper,
               models_url=(preset or {}).get("models_url") or base_url.rstrip("/") + "/v1/models",
               models=same.get("models") if isinstance(same.get("models"), dict) else None)
    interactive = sys.stdin.isatty() and not args.yes
    need = bool(preset or flags or cfg["models"])
    if not need and args.base_url and interactive:
        need = confirm("Map the model tiers to this provider's models?", False)
    cfg["models"] = choose_models(cfg, flags, bearer, interactive) if need else None
    return cfg


def provider_summary(cfg: dict) -> str:
    """One line naming a provider profile's provider, base URL, auth and tier models; never the token."""
    auth = {"token": "token file", "helper": "token helper"}.get(cfg.get("auth") or "", "none")
    models = cfg.get("models")
    tiers = ", ".join("%s=%s" % (t, models.get(t)) for t in TIERS) if isinstance(models, dict) else "tiers not mapped"
    return "%s (%s), auth: %s, %s" % (cfg.get("provider") or "custom", cfg.get("base_url"), auth, tiers)


def install_preflight(args: argparse.Namespace) -> Tuple[Path, Path, Optional[str], Path, Optional[Path],
                                                         Optional[bytes], Dict[str, Path], dict]:
    """Everything install can refuse on, before any write.

    Returns (source, target, tag, prefix, launcher, token, src_files, provider config); migrate calls it
    before it uninstalls.
    """
    source, target = resolve_source(args), resolve_target(args)
    tag = target_tag(args)
    prefix = resolve_prefix(args)
    manifest = load_manifest(target)
    check_prefix(args, target, manifest)
    launcher = prefix / "bin" / ("claude-" + tag) if tag else None
    if launcher and os.path.lexists(launcher):
        if not is_launcher(launcher):
            raise DeployError("%s exists and is not a claude-supervisor launcher; "
                              "move it aside, or choose another --tag or --prefix" % launcher)
        existing = launcher_config_dir(launcher)
        if existing is not None and existing != str(target):
            raise DeployError("claude-%s already launches %s; pick another --tag" % (tag, existing))
    token = None
    if args.token_file:
        try:
            token = Path(args.token_file).expanduser().read_bytes()
        except OSError as exc:
            raise DeployError("cannot read --token-file %s: %s; check the path" % (args.token_file, exc))
    if args.token is not None:
        token = args.token.encode()
    src_files = collect_source(source)
    load_registry(prefix)
    provider = resolve_provider(args, target, manifest or {}, token) if tag else None
    return source, target, tag, prefix, launcher, token, src_files, provider


def install_cmd(args: argparse.Namespace) -> int:
    source, target, tag, prefix, launcher, token, src_files, provider = install_preflight(args)
    pack_version = derive_version(source)
    if args.overwrite_local and not args.dry_run:
        if not confirm("--overwrite-local will back up and replace locally modified/unmanaged files in %s. Continue?"
                       % target, args.yes):
            eprint("aborted")
            return 1
    verb = "would " if args.dry_run else ""
    counts = {k: 0 for k in ("copied", "updated", "unchanged", "kept-local", "removed", "errors")}
    print("%sinstall %s -> %s" % ("[dry-run] " if args.dry_run else "", source, target))

    if tag and not args.dry_run:
        target.mkdir(mode=0o700, parents=True, exist_ok=True)
    with target_lock(target, args.dry_run):
        migrate_legacy(target, args.dry_run)
        manifest = load_manifest(target) or {}
        if tag and not manifest:
            seed_profile(target, args.dry_run, bool(provider and provider["base_url"]))
        if provider is None:
            base_url = manifest.get("base_url") if args.base_url is None else args.base_url
        else:
            base_url = provider["base_url"]
        if not tag:
            print("Note: set ANTHROPIC_DEFAULT_FABLE_MODEL to run fable agents on Opus (see docs/deploy.md)")
        prev = manifest.get("pack_version")
        print("Version: %s%s" % (pack_version or "unknown (no VERSION file in %s)" % source.parent,
                                 " (was %s)" % prev if pack_version and prev and prev != pack_version else ""))
        baseline: Dict[str, dict] = manifest.get("files", {})
        new_files: Dict[str, dict] = {}
        removed: List[str] = []

        def overwrite(key: str, src: Path, dst: Path, data: bytes, reason: str, counter: str) -> None:
            if args.dry_run:
                print("  would back up and overwrite %s (%s)" % (key, reason))
            else:
                bak = backup_file(dst)
                atomic_copy(src, dst, data)
                print("  overwrote %s (%s); backup: %s" % (key, reason, bak.name))
            counts[counter] += 1

        for key in sorted(src_files):
            src, dst = src_files[key], target / key
            data = src.read_bytes()
            src_hash = sha256_bytes(data)
            base = (baseline.get(key) or {}).get("sha256")
            if dst.is_symlink() or (dst.exists() and not dst.is_file()):
                print("  ERROR %s: target is a symlink or not a regular file; skipped; "
                      "replace it with a regular file or remove it, then re-run" % key)
                counts["errors"] += 1
                if base:
                    new_files[key] = baseline[key]
                continue
            if not dst.exists():
                print("  %scopy %s" % (verb, key))
                if not args.dry_run:
                    atomic_copy(src, dst, data)
                counts["copied"] += 1
                new_files[key] = {"sha256": src_hash}
                continue
            dst_hash = sha256_file(dst)
            if dst_hash == src_hash:
                counts["unchanged"] += 1
                new_files[key] = {"sha256": src_hash}  # also refreshes a stale baseline
                continue
            if base is None:
                if args.overwrite_local:
                    overwrite(key, src, dst, data, "unmanaged file", "updated")
                    new_files[key] = {"sha256": src_hash}
                else:
                    print("  ERROR %s: exists but is not managed by this pack; not touched "
                          "(run ./deploy install --overwrite-local from your checkout to replace it)" % key)
                    counts["errors"] += 1
                continue
            if dst_hash == base:
                print("  %supdate %s" % (verb, key))
                if not args.dry_run:
                    atomic_copy(src, dst, data)
                counts["updated"] += 1
                new_files[key] = {"sha256": src_hash}
            elif args.overwrite_local:
                overwrite(key, src, dst, data, "local edits", "updated")
                new_files[key] = {"sha256": src_hash}
            else:
                print("  WARNING %s: locally modified; kept (use --overwrite-local to replace)" % key)
                counts["kept-local"] += 1
                new_files[key] = {"sha256": base}

        for key in sorted(set(baseline) - set(src_files)):
            dst = target / key
            base = (baseline.get(key) or {}).get("sha256")
            if not dst.is_file():
                continue
            if sha256_file(dst) == base:
                print("  %sremove %s (no longer in source)" % (verb, key))
                if not args.dry_run:
                    dst.unlink()
                removed.append(key)
                counts["removed"] += 1
            else:
                print("  WARNING %s: removed from source but locally modified; kept and no longer managed" % key)
                counts["kept-local"] += 1
        prune_empty_dirs(target, removed, args.dry_run)

        # settings.json
        settings_rec = manifest.get("settings") or {"managed_agent_key": False, "previous_agent": None}
        new_settings = None
        try:
            settings = load_settings(target)
            new_settings, settings_rec, settings_msg = plan_settings(args, settings, settings_rec)
            if not args.use_global:
                attr_settings, attr_rec, attr_msg = plan_attribution(
                    new_settings or settings, manifest.get("settings") or {})
                settings_rec = dict(settings_rec, **attr_rec)
                settings_msg += "; " + attr_msg
                new_settings = attr_settings or new_settings
            if provider is not None and (base_url or (manifest.get("settings") or {}).get("managed_api_key_helper")):
                helper_settings, helper_rec, helper_msg = plan_api_key_helper(
                    new_settings or settings, manifest.get("settings") or {},
                    provider["token_helper"] if provider["auth"] == "helper" else None)
                settings_rec = dict(settings_rec, **helper_rec)
                if helper_msg:
                    settings_msg += "; " + helper_msg
                new_settings = helper_settings or new_settings
            rule_settings, rule_msg = plan_critic_rule(new_settings or settings, target)
            settings_msg += "; " + rule_msg
            new_settings = rule_settings or new_settings
            if new_settings is not None:
                if args.dry_run:
                    settings_msg = "would " + settings_msg
        except DeployError as exc:
            settings_msg = "ERROR: %s (settings step skipped, file not changed)" % exc
            counts["errors"] += 1

        commit, dirty = git_info(source)
        branch = git_branch(source)
        if branch is None and commit is not None:
            print("WARNING: %s is on a detached HEAD; recording branch main for update" % source)
        new_manifest = {
            "version": MANIFEST_VERSION,
            "source_dir": str(source),
            "source_commit": commit,
            "source_dirty": dirty,
            "pack_version": pack_version,
            "installed_at": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"),
            "files": dict(sorted(new_files.items())),
            "settings": settings_rec,
            "tag": tag,
            "launcher": str(launcher) if launcher else None,
            "prefix": str(prefix),
            "base_url": base_url or None,
        }
        if provider is not None:
            new_manifest.update((k, provider[k]) for k in ("provider", "auth", "token_helper", "models"))
        if not args.dry_run:
            # Order the writes so a crash between them never leaves an unmanaged "supervisor" key:
            # record a key before setting it, and restore a released key before un-recording it.
            # A released apiKeyHelper is removed before the manifest stops recording it. This protects one
            # key at a time: a run that claims one key and releases the other has a crash window for the other.
            released = bool((manifest.get("settings") or {}).get("managed_api_key_helper")) \
                and not settings_rec.get("managed_api_key_helper")
            claim = new_settings is not None and not released and \
                (settings_rec["managed_agent_key"] or bool(settings_rec.get("managed_api_key_helper")))
            if new_settings is not None and not claim:
                bak = save_settings(target, new_settings)
            write_json_atomic(target / MANIFEST_NAME, new_manifest)
            if claim:
                bak = save_settings(target, new_settings)
            if new_settings is not None and bak:
                settings_msg += " (backup: %s)" % bak.name
            if launcher:
                helper = provider["auth"] == "helper"
                if helper or (manifest.get("base_url") and not base_url and token is None):
                    # the helper supplies the token, or the provider was cleared: a static one must not linger
                    with contextlib.suppress(FileNotFoundError):
                        (target / "token").unlink()
                elif token is not None:
                    atomic_write_bytes(target / "token", token, mode=0o600)
                text = launcher_text(tag, target, prefix, base_url, (target / "token").exists(),
                                     provider["models"], helper, provider["provider"])
                atomic_write_bytes(launcher, text.encode(), mode=0o755)
            remote, old = git_remote(source), load_registry(prefix).get(str(target))
            if old is not None and (old.get("remote") != remote or entry_branch(old) != (branch or "main")):
                print("now tracking branch %s of %s" % (branch or "main", remote or "no remote"))
            register_install(prefix, target, tag, remote, branch)
            atomic_write_bytes(state_dir(prefix) / "deploy", Path(__file__).read_bytes(), mode=0o755)
            # beside the tool copy like VERSION beside deploy in a checkout, so its --version works
            if pack_version is not None:
                atomic_write_bytes(state_dir(prefix) / "VERSION", (pack_version + "\n").encode(), mode=0o644)
            else:
                with contextlib.suppress(FileNotFoundError):
                    (state_dir(prefix) / "VERSION").unlink()

    print("\nSummary: " + ", ".join("%s=%d" % kv for kv in counts.items()))
    print("Settings: " + settings_msg)
    if launcher:
        print("Launcher: %s" % launcher)
        if provider["base_url"]:
            print("Provider: %s" % provider_summary(provider))
        if not getattr(args, "migrating", False) and not on_path(prefix / "bin"):
            print('WARNING %s is not on your PATH; add export PATH="%s:$PATH" to your shell profile, '
                  "then open a new terminal" % (prefix / "bin", prefix / "bin"))
    if shutil.which("codex") and critic_backend(target) != "codex":
        cmd = "%s critic enable" % launcher.name if launcher else \
            "./deploy critic enable" + (" --global" if args.use_global else " --target %s" % target)
        print("Codex as critic is off; enable with `%s`" % cmd)
    if args.dry_run:
        print("Dry run: nothing was written.")
    return 1 if counts["errors"] else 0


# --------------------------------------------------------------------------- status

def file_states(target: Path, manifest: dict, source: Optional[Path],
                src_files: Optional[Dict[str, Path]] = None) -> List[Tuple[str, str]]:
    """Row per file; `src_files` is `collect_source(source)` when the caller already has it."""
    if source is not None and src_files is None:
        src_files = collect_source(source)
    src_files = src_files or {}
    rows = []
    for key, entry in sorted(manifest["files"].items()):
        dst = target / key
        if not dst.is_file():
            rows.append((key, "missing"))
            continue
        h = sha256_file(dst)
        if h != entry.get("sha256"):
            rows.append((key, "modified"))
        elif source is not None and key not in src_files:
            rows.append((key, "outdated (removed from source)"))
        elif key in src_files and sha256_file(src_files[key]) != h:
            rows.append((key, "outdated"))
        else:
            rows.append((key, "ok"))
    for key in sorted(set(src_files) - set(manifest["files"])):
        rows.append((key, "not installed"))
    return rows


def status_cmd(args: argparse.Namespace) -> int:
    target = resolve_target(args)
    manifest = load_manifest(target)
    print("Target: %s" % target)
    if manifest is None:
        print("No manifest: pack is not installed here.")
    else:
        if not (target / MANIFEST_NAME).exists():
            print("Note: legacy manifest %s; run ./deploy install from your checkout to migrate" % LEGACY_MANIFEST_NAME)
        src_files: Optional[Dict[str, Path]] = None
        source = resolve_source(args) if args.source else Path(str(manifest.get("source_dir") or ""))
        if args.source or (manifest.get("source_dir") and source.is_dir()):
            try:
                src_files = collect_source(source)
            except DeployError:
                if args.source:
                    raise
        if src_files is None:
            hint = "pass"
            if getattr(args, "launcher", False):
                hint = "run ./deploy status --tag %s" % args.tag
                if target != Path("~/.config/claude-" + args.tag).expanduser().resolve():
                    hint += " --target %s" % target
            print("Source: %s (not available; %s --source <checkout>/pack to compare)" % (manifest.get("source_dir"), hint))
        else:
            print("Source: %s" % manifest.get("source_dir"))
        try:
            reg_prefix = Path(manifest["prefix"]) if manifest.get("prefix") else resolve_prefix(args)
            entry = load_registry(reg_prefix).get(str(target))
            if entry is None:
                print("Remote: not registered")
            else:
                print("Remote: %s" % (entry.get("remote") or "none"))
                print("Branch: %s" % entry_branch(entry))
        except DeployError as exc:
            print("Remote: %s" % exc)
        print("Commit: %s%s" % (manifest.get("source_commit"), " (dirty)" if manifest.get("source_dirty") else ""))
        print("Installed: %s" % manifest.get("installed_at"))
        if manifest.get("launcher"):
            print("Launcher: %s" % manifest["launcher"])
        if manifest.get("base_url"):
            print("Provider: %s" % (manifest.get("provider") or "custom"))
            print("Base URL: %s" % manifest["base_url"])
            auth = manifest.get("auth")
            print("Auth: %s" % ("token helper %s" % manifest.get("token_helper") if auth == "helper"
                                else "token file %s" % (target / "token") if auth == "token" else "none"))
            models = manifest.get("models") if isinstance(manifest.get("models"), dict) else {}
            for tier in TIERS:
                print("Model %s: %s" % (tier, models.get(tier) or "not mapped"))
        recorded = manifest.get("pack_version")
        if src_files is None:
            print("Version: installed=%s (source not available)" % (recorded or "not recorded"))
            rows = file_states(target, manifest, None)
        else:
            current = derive_version(source)
            flag = " (MISMATCH: run ./deploy install from your checkout)" if recorded and current and recorded != current else ""
            print("Version: installed=%s, source=%s%s" % (recorded or "not recorded", current or "unknown", flag))
            rows = file_states(target, manifest, source, src_files)
        width = max([len(k) for k, _ in rows] + [10])
        for key, state in rows:
            print("  %-*s  %s" % (width, key, state))
        summary: Dict[str, int] = {}
        for _, state in rows:
            key = state.split(" (")[0]
            summary[key] = summary.get(key, 0) + 1
        print("Files: " + ", ".join("%s=%d" % kv for kv in sorted(summary.items())))
    try:
        settings = load_settings(target)
        rec = (manifest or {}).get("settings") or {}
        print("Settings agent: %r%s" % (settings.get("agent"), " (managed)" if rec.get("managed_agent_key") else ""))
        attr = settings.get("attribution")
        for key, _, flag, _ in ATTRIBUTION_KEYS:
            if rec.get(flag) and isinstance(attr, dict):
                print("Settings attribution.%s: %r (managed)" % (key, attr.get(key)))
    except DeployError as exc:
        print("Settings: %s" % exc)
    return 0


# --------------------------------------------------------------------------- list

def list_row(key: str, entry: dict) -> Tuple[str, ...]:
    tag, branch = "(global)" if entry.get("tag") is None else entry["tag"], entry_branch(entry)
    try:
        m = load_manifest(Path(key))
    except DeployError:
        return (tag, key, "(error)", branch, "-", "-")
    if m is None:
        return (tag, key, "(no manifest)", branch, "-", "-")
    commit = (m.get("source_commit") or "-")[:7]
    if commit != "-" and m.get("source_dirty"):
        commit += "-dirty"
    launcher = m.get("launcher")
    return (tag, key, m.get("pack_version") or "-", branch, commit,
            "-" if not launcher else "yes" if is_launcher(Path(launcher)) else "missing")


def list_cmd(args: argparse.Namespace) -> int:
    installs = load_registry(resolve_prefix(args))
    if not installs:
        print("No registered installs.")
        return 0
    rows = [("TAG", "TARGET", "VERSION", "BRANCH", "COMMIT", "LAUNCHER")]
    rows += [list_row(key, entry) for key, entry in installs.items()]
    widths = [max(len(r[i]) for r in rows) for i in range(6)]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    return 0


# --------------------------------------------------------------------------- uninstall

def uninstall_all(args: argparse.Namespace) -> int:
    check_all_exclusive(args)
    prefix = resolve_prefix(args)
    installs = load_registry(prefix)
    if not installs:
        print("No registered installs.")
        return 0
    if not args.dry_run:
        listing = ", ".join(k + ("" if v.get("tag") is None else " (deletes sessions, history, login)")
                            for k, v in installs.items())
        if not confirm("Uninstall every registered install: %s?" % listing, args.yes):
            eprint("aborted")
            return 1
    failed = 0
    for key, entry in list(installs.items()):
        argv = ["uninstall", "--yes", "--prefix", str(prefix)] + entry_selection(key, entry) + \
            (["--dry-run"] if args.dry_run else []) + (["--force"] if args.force else [])
        print("== uninstall %s ==" % key)
        try:
            rc = uninstall_cmd(build_parser().parse_args(argv))
        except DeployError as exc:
            print("ERROR %s: %s" % (key, exc))
            rc = 1
        failed += rc != 0
    return 1 if failed else 0


def uninstall_cmd(args: argparse.Namespace) -> int:
    if args.all and args.launcher:
        raise DeployError("use ./deploy uninstall --all")
    if args.all:
        return uninstall_all(args)
    target, prefix = resolve_target(args), resolve_prefix(args)
    manifest = load_manifest(target)
    check_prefix(args, target, manifest)
    if manifest is None:
        print("No manifest in %s; nothing to uninstall.%s" % (
            target, "" if args.use_global or not target.exists() else
            " The directory still exists; delete it by hand if you no longer need it."))
        if not args.dry_run and unregister_install(prefix, target):
            print("Removed stale registry entry for %s" % target)
        return 0
    tag = target_tag(args)
    prompt = "Delete %s (sessions, history, login) and its launcher?" if tag else \
        "Remove the agent pack from %s?"
    if args.dry_run:
        ok = True
    elif args.launcher:
        ok = confirm_typed(prompt % target, tag, args.yes)
    else:
        ok = confirm(prompt % target, args.yes)
    if not ok:
        eprint("aborted")
        return 1
    if tag:
        launcher = manifest.get("launcher")
        if args.dry_run:
            print("[dry-run] would remove %s" % ("%s and %s" % (target, launcher) if launcher else target))
            return 0
        shutil.rmtree(target)
        gone = [str(target)]
        if launcher and is_launcher(Path(launcher)):
            Path(launcher).unlink()
            gone.append(launcher)
        elif launcher and os.path.lexists(launcher):
            print("WARNING %s is not a claude-supervisor launcher; left in place" % launcher)
        unregister_install(prefix, target)
        print("Removed %s" % " and ".join(gone))
        return 0
    verb = "would " if args.dry_run else ""
    kept: List[str] = []
    removed: List[str] = []
    errors = 0
    critic = target.joinpath(*CRITIC_SCRIPT)
    if critic.is_file():
        if args.dry_run:
            print("  would run codex-critic disable (removes supervisor-config.json)")
        else:
            try:
                rc = subprocess.call([sys.executable, str(critic), "disable", "--yes"])
            except OSError as exc:
                rc = exc
            if rc != 0:
                print("  WARNING codex-critic disable failed (%s); remove supervisor-config.json by hand" % rc)
    with target_lock(target, args.dry_run):
        for key, entry in sorted(manifest["files"].items()):
            dst = target / key
            if not dst.is_file():
                continue
            if sha256_file(dst) != entry.get("sha256") and not args.force:
                kept.append(key)
                continue
            print("  %sremove %s" % (verb, key))
            if not args.dry_run:
                dst.unlink()
            removed.append(key)
        prune_empty_dirs(target, removed, args.dry_run)

        rec = manifest.get("settings") or {}
        settings_msg = "agent left untouched (not managed by this pack)"
        try:
            settings = load_settings(target)
            new = dict(settings)
            changed = False
            actions = []  # what this uninstall changes, reported before any note
            rule = critic_rule(target)
            perms = settings.get("permissions")
            allow = perms.get("allow") if isinstance(perms, dict) else None
            if isinstance(allow, list) and rule in allow:
                kept_allow = [a for a in allow if a != rule]
                new_perms = dict(perms, allow=kept_allow)
                if not kept_allow:
                    del new_perms["allow"]
                if new_perms:
                    new["permissions"] = new_perms
                else:
                    del new["permissions"]
                changed = True
                actions.append("remove its permission rule")
            if rec.get("managed_agent_key") and settings.get("agent") == DEFAULT_AGENT:
                prev = rec.get("previous_agent")
                if prev is None:
                    new.pop("agent", None)
                    actions.append("remove agent key")
                else:
                    new["agent"] = prev
                    actions.append("restore agent = %r" % prev)
                settings_msg = ""
                changed = True
            elif rec.get("managed_agent_key"):
                settings_msg = "agent changed by user to %r; left untouched" % settings.get("agent")
            if changed:
                done = ("would " if args.dry_run else "") + "; ".join(actions)
                settings_msg = "; ".join(m for m in (done, settings_msg) if m)
                if not args.dry_run:
                    save_settings(target, new)
        except DeployError as exc:
            settings_msg = "ERROR: %s" % exc
            errors += 1

        if not args.dry_run:
            if errors:
                print("manifest kept because of errors; fix them and re-run uninstall")
            else:
                for name in (MANIFEST_NAME, LEGACY_MANIFEST_NAME):
                    with contextlib.suppress(FileNotFoundError):
                        (target / name).unlink()
                unregister_install(prefix, target)
    if not args.dry_run:
        for name in (LOCK_NAME, LEGACY_LOCK_NAME):
            with contextlib.suppress(OSError):
                (target / name).unlink()

    for key in kept:
        print("  WARNING kept locally modified %s (now unmanaged; delete it by hand)" % key)
    print("\nSummary: removed=%d, kept-modified=%d, errors=%d" % (len(removed), len(kept), errors))
    print("Settings: " + settings_msg)
    if args.dry_run:
        print("Dry run: nothing was written.")
    return 1 if errors else 0


# --------------------------------------------------------------------------- update

def replay_install(key: str, entry: dict, manifest: dict, source: Path, dry_run: bool) -> int:
    """Re-run install from `source` for the registry entry, with the manifest's options (never --overwrite-local)."""
    argv = ["install", "--source", str(source / "pack")]
    argv += entry_selection(key, entry)
    argv += ["--prefix", manifest.get("prefix") or str(Path("~/.local").expanduser().resolve())]
    if not (manifest.get("settings") or {}).get("managed_agent_key"):
        argv.append("--no-default-agent")
    if dry_run:
        argv.append("--dry-run")
    print("== update %s ==" % key)
    try:
        return install_cmd(build_parser().parse_args(argv))
    except DeployError as exc:
        print("ERROR %s: %s" % (key, exc))
        return 1


def downgrade_ok(key: str, manifest: dict, new_version: Optional[str], assume_yes: bool, dry_run: bool) -> bool:
    """False when the install is newer than what update would put there and the user declines."""
    old = manifest.get("pack_version")
    old_key, new_key = version_key(old), version_key(new_version)
    if not (old_key and new_key and old_key > new_key):
        return True
    print("WARNING %s: installed %s is newer than %s, which update would install" % (key, old, new_version))
    return dry_run or confirm("Continue with the update?", assume_yes)


def update_cmd(args: argparse.Namespace) -> int:
    prefix = resolve_prefix(args)
    installs = load_registry(prefix)
    if args.all:
        if not args.launcher:
            check_all_exclusive(args)
        if not installs:
            print("No registered installs.")
            return 0
        selected = installs
    else:
        target = resolve_target(args)
        if str(target) not in installs:
            raise DeployError("%s is not registered under prefix %s; run ./deploy install once "
                              "(pass --prefix if you installed with one)" % (target, prefix))
        selected = {str(target): installs[str(target)]}
    source = Path(args.from_dir).expanduser().resolve() if args.from_dir else None
    if source is not None and args.all:
        remote, branch = git_remote(source), git_branch(source) or "main"
        selected = {k: v for k, v in selected.items()
                    if v.get("remote") == remote and entry_branch(v) == branch}
        if not selected:
            print("no registered install follows branch %s of %s; nothing updated" % (branch, remote or "no remote"))
            return 0
    if selected and not args.dry_run and (args.all or args.launcher):
        listing = ", ".join("%s (%s, branch %s)" % (k, v.get("remote") or "no remote", entry_branch(v))
                            for k, v in selected.items())
        if args.all:
            question = "Update every registered install: %s%s?" % (listing, " and run claude update" if args.launcher else "")
        else:
            entry = selected[str(target)]
            question = "Update %s from %s (branch %s) and run claude update?" \
                % (target, entry.get("remote") or "no remote", entry_branch(entry))
        if not confirm(question, args.yes):
            eprint("aborted")
            return 1

    failed = stale = 0
    if args.launcher and selected:
        if args.dry_run:
            print("[dry-run] would run claude update")
        else:
            print("== claude update ==")
            sys.stdout.flush()
            try:
                rc = subprocess.run(["claude", "update"]).returncode
                if rc != 0:
                    print("ERROR claude update failed (exit %d); updating the pack anyway" % rc)
                    failed += 1
            except OSError as exc:
                print("ERROR claude update: %s; updating the pack anyway" % exc)
                failed += 1
        sys.stdout.flush()
    groups: Dict[Tuple[str, str], List[str]] = {}
    manifests: Dict[str, dict] = {}
    for key, entry in selected.items():
        try:
            manifest = load_manifest(Path(key))
        except DeployError as exc:
            print("ERROR %s: %s" % (key, exc))
            failed += 1
            continue
        if manifest is None:
            print("SKIP %s: no manifest" % key)
        elif source is not None:
            if downgrade_ok(key, manifest, derive_version(source / "pack"), args.yes, args.dry_run):
                failed += replay_install(key, entry, manifest, source, args.dry_run) != 0
            else:
                print("%s left unchanged" % key)
                failed += 1
        elif entry.get("remote") is None:
            print("ERROR %s: no recorded remote; run ./deploy install from your checkout, or pass --from" % key)
            failed += 1
        else:
            manifests[key] = manifest
            groups.setdefault((entry["remote"], entry_branch(entry)), []).append(key)

    for (remote, branch), keys in groups.items():
        try:
            rc = subprocess.run(["git", "ls-remote", "--exit-code", "--heads", remote, "refs/heads/" + branch],
                                stdout=subprocess.DEVNULL, timeout=60).returncode
            problem = "git ls-remote exit %d" % rc
        except FileNotFoundError:
            print("ERROR git not found on PATH; install git")
            failed += len(keys)
            continue
        except (OSError, subprocess.SubprocessError) as exc:
            rc, problem = -1, str(exc)
        if rc == 2:
            for key in keys:
                tag = selected[key].get("tag")
                how = "claude-%s uninstall (or ./deploy uninstall --tag %s --target %s)" % (tag, tag, key) \
                    if tag else "./deploy uninstall --global"
                print("STALE %s: nothing to update; branch %s is gone from %s; this install is stale. "
                      "Remove it with: %s" % (key, branch, remote, how))
            stale += len(keys)
            continue
        if rc != 0:
            print("ERROR %s: cannot read branch %s (%s); check network access and credentials"
                  % (remote, branch, problem))
            failed += len(keys)
            continue
        with tempfile.TemporaryDirectory() as tmp:
            clone = Path(tmp) / "src"
            try:
                # A branch other than main needs a full clone so origin/main gives it a merge-base.
                cloned = subprocess.run(["git", "clone"] + (["--depth", "1"] if branch == "main" else [])
                                        + ["--branch", branch, "--quiet", remote, str(clone)]).returncode == 0
            except FileNotFoundError:
                print("ERROR git not found on PATH; install git")
                failed += len(keys)
                continue
            except OSError:
                cloned = False
            if not cloned:
                print("ERROR %s (branch %s): clone failed; check network access, credentials and that the "
                      "branch exists, or pass --from DIR" % (remote, branch))
                failed += len(keys)
                continue
            new_version = derive_version(clone / "pack")
            for key in keys:
                if not downgrade_ok(key, manifests[key], new_version, args.yes, args.dry_run):
                    print("%s left unchanged" % key)
                    failed += 1
                    continue
                argv = [sys.executable, str(clone / "deploy"), "update", "--from", str(clone), "--prefix", str(prefix)] + \
                    entry_selection(key, selected[key]) + ["--yes"] + (["--dry-run"] if args.dry_run else [])
                sys.stdout.flush()
                failed += subprocess.run(argv).returncode != 0
    return 1 if failed else (EXIT_STALE if stale else 0)


# --------------------------------------------------------------------------- migrate

def migrate_cmd(args: argparse.Namespace) -> int:
    """Move a pack installed in ~/.claude to the default profile, backing up settings.json and edited files."""
    home = Path("~/.claude").expanduser().resolve()
    prefix = resolve_prefix(args)
    profile = Path("~/.config/claude-" + DEFAULT_TAG).expanduser().resolve()
    dry = ["--dry-run"] if args.dry_run else []
    inst = build_parser().parse_args(["install", "--prefix", str(prefix)] + dry)
    inst.migrating = True  # install skips its PATH hint; migrate prints its own below
    install_preflight(inst)  # refuse before removing anything
    manifest = load_manifest(home)
    removed_msg = None
    if manifest is None:
        print("No pack install in %s; installing the default profile." % home)
    else:
        files = manifest["files"]
        edited = [k for k in sorted(files) if (home / k).is_file()
                  and sha256_file(home / k) != files[k].get("sha256")]
        backup = home / ("claude-supervisor-backup-" + timestamp())
        n = 1
        while backup.exists():
            backup = home / ("claude-supervisor-backup-%s-%d" % (timestamp(), n))
            n += 1
        recorded = manifest.get("prefix") or str(Path("~/.local").expanduser().resolve())
        load_registry(Path(recorded))  # the uninstall below registers under this prefix; fail before removing
        if not args.dry_run and not confirm(
                "Remove the agent pack from %s (%d files, %d edited) and install the default profile %s? "
                "settings.json and edited files are backed up to %s."
                % (home, len(files), len(edited), profile, backup), args.yes):
            eprint("aborted")
            return 1
        saved = (["settings.json"] if (home / "settings.json").exists() else []) + edited
        for rel in saved:
            if args.dry_run:
                print("  would back up %s" % rel)
                continue
            (backup / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(str(home / rel), str(backup / rel))
            print("  backed up %s" % rel)
        if saved:
            print("Would back up to %s" % backup if args.dry_run else "Backup: %s" % backup)
        if not args.dry_run:
            removed_msg = ("pack files were removed from ~/.claude (backup: %s); "
                           "fix the error above and re-run ./deploy migrate" % backup)
        if uninstall_cmd(build_parser().parse_args(
                ["uninstall", "--global", "--yes", "--force", "--prefix", recorded] + dry)) != 0:
            print(removed_msg or "fix the error above and re-run ./deploy migrate")
            return 1
    try:
        rc = install_cmd(inst)
    except (DeployError, OSError) as exc:
        if removed_msg is None:
            raise
        eprint("error: %s" % exc)
        eprint(removed_msg)
        return 2
    bin_dir = prefix / "bin"
    if on_path(bin_dir):
        print("PATH: %s is on PATH" % bin_dir)
    else:
        print("WARNING: %s is not on PATH; add this line to your shell profile:" % bin_dir)
        print('  export PATH="%s:$PATH"' % bin_dir)
    return rc


# --------------------------------------------------------------------------- doctor

def parse_version(text: str) -> Optional[Tuple[int, int, int]]:
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    return tuple(int(x) for x in m.groups()) if m else None  # type: ignore[return-value]


def claude_version() -> Optional[str]:
    """The output of `claude --version` ("error: ..." when it cannot run), or None when claude is not on PATH."""
    claude = shutil.which("claude")
    if not claude:
        return None
    try:
        return subprocess.run([claude, "--version"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        return "error: %s" % exc


def is_truthy(value: object) -> bool:
    return str(value).strip().lower() in ("1", "true", "yes", "on")


def install_hint(args: argparse.Namespace) -> str:
    """The install command for the target doctor checks, with any non-default --tag/--target."""
    hint = "./deploy install"
    if args.use_global:
        return hint + " --global"
    if args.tag not in (None, DEFAULT_TAG):
        hint += " --tag %s" % args.tag
    return hint + (" --target %s" % args.target if args.target else "")


CRITIC_SCRIPT = ("skills", "supervisor-config", "scripts", "codex-critic")


def critic_backend(target: Path) -> str:
    """The critic backend recorded in <target>/supervisor-config.json: "codex", else "claude"."""
    try:
        data = json.loads((target / "supervisor-config.json").read_text(encoding="utf-8"))
        critic = data.get("critic") if isinstance(data, dict) else None
        return "codex" if isinstance(critic, dict) and critic.get("backend") == "codex" else "claude"
    except (OSError, ValueError):
        return "claude"


def critic_cmd(args: argparse.Namespace) -> int:
    """Run the installed codex-critic script (enable, disable, status) for the resolved target."""
    rest = list(args.rest)
    if not getattr(args, "launcher", False):  # target flags after the verb land in REMAINDER; take them back out
        tp = argparse.ArgumentParser(add_help=False)
        tp.add_argument("--tag")
        tp.add_argument("--target")
        tp.add_argument("--global", dest="use_global", action="store_true")
        tp.add_argument("--prefix")
        ns, rest = tp.parse_known_args(rest)
        args.tag = ns.tag or args.tag
        args.target = ns.target or args.target
        args.use_global = ns.use_global or args.use_global
        args.prefix = ns.prefix or args.prefix
    target = resolve_target(args)
    script = target.joinpath(*CRITIC_SCRIPT)
    if not script.is_file():
        raise DeployError("%s has no codex-critic script (%s); run ./deploy install first" % (target, script))
    return subprocess.call([sys.executable, str(script), args.verb] + rest)


def doctor_cmd(args: argparse.Namespace) -> int:
    target = resolve_target(args)
    hint = install_hint(args)
    results: List[Tuple[str, str]] = []

    def add(level: str, msg: str) -> None:
        results.append((level, msg))
        print("%-4s %s" % (level, msg))

    print("Target: %s" % target)
    add("PASS" if sys.version_info >= (3, 9) else "FAIL", "python %s%s" % (
        sys.version.split()[0], "" if sys.version_info >= (3, 9) else "; deploy needs 3.9 or newer"))

    out = claude_version()
    if out is None:
        add("FAIL", "claude CLI not found on PATH; install Claude Code and open a new terminal")
    else:
        ver = parse_version(out)
        need = ".".join(map(str, MIN_CLAUDE_VERSION))
        if ver is None:
            add("FAIL", "cannot determine claude version from `claude --version`: %r; reinstall Claude Code"
                % out.strip())
        elif ver >= MIN_CLAUDE_VERSION:
            add("PASS", "claude %s (>= %s)" % (".".join(map(str, ver)), need))
        else:
            add("FAIL", "claude %s is older than %s; run `claude update`" % (".".join(map(str, ver)), need))

    try:
        manifest = load_manifest(target)
    except DeployError as exc:
        manifest = None
        add("FAIL", str(exc))
    else:
        if manifest is None:
            add("WARN", "pack not installed in %s yet; run %s from your checkout" % (target, hint))
        else:
            rows = file_states(target, manifest, None)
            missing = [k for k, s in rows if s == "missing"]
            modified = [k for k, s in rows if s == "modified"]

            def names(keys: List[str]) -> str:
                return ", ".join(keys[:5]) + (" ..." if len(keys) > 5 else "")

            if not missing and not modified:
                add("PASS", "%d managed files intact" % len(rows))
            if missing:
                add("FAIL", "%d managed files missing: %s; run %s" % (len(missing), names(missing), hint))
            if modified:
                add("WARN", "%d managed files modified: %s; keep them, or run %s --overwrite-local"
                    % (len(modified), names(modified), hint))

    env_block: Dict[str, object] = {}
    try:
        settings = load_settings(target)
        agent = settings.get("agent")
        if manifest is None:
            pass  # nothing installed here, so the agent setting is not ours to judge
        elif agent == DEFAULT_AGENT:
            add("PASS", "settings agent = %r" % agent)
        else:
            add("WARN", "settings agent = %r (expected %r; supervisor is not the default); "
                "run %s (--force-default-agent to replace another agent)" % (agent, DEFAULT_AGENT, hint))
        if isinstance(settings.get("env"), dict):
            env_block = settings["env"]
    except DeployError as exc:
        add("FAIL", str(exc))

    UNSET = "unset it, or remove it from settings.json env"
    for origin, env in (("environment", os.environ), ("settings.json env", env_block)):
        depth = env.get("CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH")
        if depth is not None:
            try:
                if int(str(depth)) < 2:
                    add("WARN", "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=%s in %s; full mode needs >= 2; %s" % (depth, origin, UNSET))
            except ValueError:
                add("WARN", "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=%r in %s is not an integer; %s" % (depth, origin, UNSET))
        if is_truthy(env.get("CLAUDE_CODE_SUBAGENT_MODEL_FORCE", "")):
            add("WARN", "CLAUDE_CODE_SUBAGENT_MODEL_FORCE set in %s; per-agent models/effort are ignored; %s" % (origin, UNSET))
        if env.get("CLAUDE_CODE_EFFORT_LEVEL") not in (None, ""):
            add("WARN", "CLAUDE_CODE_EFFORT_LEVEL set in %s; it overrides per-agent effort; %s" % (origin, UNSET))

    if manifest and manifest.get("base_url"):
        name = manifest.get("provider")
        add("PASS", "provider: %s, %s" % (name or "custom", manifest["base_url"]))
        auth, token_file = manifest.get("auth"), target / "token"
        if auth == "token" and not token_file.is_file():
            add("FAIL", "%s is missing; run %s --token-file PATH" % (token_file, hint))
        elif auth == "token" and token_file.stat().st_mode & 0o777 != 0o600:
            add("FAIL", "%s is mode %o, not 600; run chmod 600 %s"
                % (token_file, token_file.stat().st_mode & 0o777, token_file))
        elif auth == "helper":
            try:
                check_helper(str(manifest.get("token_helper") or ""),
                             PROVIDERS.get(name or "", {}).get("login", "check the helper's login"))
                add("PASS", "token helper prints a token")
            except DeployError as exc:
                add("FAIL", str(exc))
        for key in sorted(k for k in env_block if k.startswith("ANTHROPIC_")):
            add("WARN", "%s in settings.json env overrides the launcher; remove it" % key)

    if shutil.which("git"):
        add("PASS", "git found")
    else:
        add("WARN", "git not found; needed for ./deploy update and to clone, optional otherwise")
    add("PASS" if shutil.which("zip") else "WARN",
        "zip found" if shutil.which("zip") else "zip not found (optional, used by some skills)")

    backend = critic_backend(target)
    add("PASS", "critic backend: %s" % backend)
    if backend == "codex":
        if not shutil.which("codex"):
            add("FAIL", "critic backend is codex but codex CLI not found on PATH; install Codex, or turn it off with `codex-critic disable`")
        else:
            try:
                p = subprocess.run(["codex", "login", "status"], capture_output=True, text=True, timeout=30)
                ok = p.returncode == 0 and "Logged in" in p.stdout + p.stderr
            except (OSError, subprocess.SubprocessError):
                ok = False
            add("PASS" if ok else "FAIL", "codex found, logged in" if ok else
                "codex is not logged in; run `codex login`")

    fails = sum(1 for lvl, _ in results if lvl == "FAIL")
    warns = sum(1 for lvl, _ in results if lvl == "WARN")
    print("\n%d FAIL, %d WARN" % (fails, warns))
    return 1 if fails else 0



