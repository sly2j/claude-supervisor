# --------------------------------------------------------------------------- memory

MEMORY_ITEMS = ((".supervisor", True), ("CLAUDE.local.md", False))  # (name, is_dir)
MEMORY_EXCLUDES = tuple("/" + name for name, _ in MEMORY_ITEMS)
RESIDUE_IGNORE = ".supervisor/working/residue/"
MEMORY_MARKER = "<!-- claude-supervisor memory: rewritten on every run -->"
MEMORY_TEMPLATE = ("skills", "project-memory", "templates", "store-readme.md")


def memory_root(args: argparse.Namespace) -> Path:
    """The directory holding one subdirectory per project: --root, else the environment, else the XDG data dir."""
    root = getattr(args, "root", None) or os.environ.get("CLAUDE_SUPERVISOR_MEMORY_ROOT")
    if not root:
        data = os.environ.get("XDG_DATA_HOME") or "~/.local/share"
        root = os.path.join(data, "claude-supervisor", "memory")
    return Path(root).expanduser().resolve()


def memory_git(cwd: Path, *argv: str) -> Optional[str]:
    """Stdout of `git -C cwd <argv>` (not stripped), or None when it fails or git is missing."""
    try:
        out = subprocess.run(["git", "-C", str(cwd)] + list(argv), capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def memory_project(cwd: Path) -> Tuple[Path, Optional[Path]]:
    """(main toplevel, this worktree's toplevel when cwd is in a linked worktree, else None)."""
    out = memory_git(cwd, "rev-parse", "--show-toplevel", "--git-dir", "--git-common-dir")
    lines = out.splitlines() if out else []
    if len(lines) != 3:
        raise DeployError("not a git repository: %s; run this inside a project checkout" % cwd)
    top, gdir, common = [(cwd / ln).resolve() for ln in lines]
    if gdir == common:
        return top, None
    if common.name != ".git":
        raise DeployError("cannot find the main checkout of this worktree (git dir %s)" % common)
    return common.parent, top


def memory_name(toplevel: Path, override: Optional[str]) -> str:
    """The per-project directory name: --name, else the origin URL's basename, else the toplevel's basename."""
    if override is None:
        url = git_remote(toplevel)
        base = re.split(r"[/:]", url.rstrip("/"))[-1] if url else ""
        if base.endswith(".git"):
            base = base[:-4]
        name = base or toplevel.name
    else:
        name = override
    if not name or "/" in name or name in (".", ".."):
        raise DeployError("invalid project name %r; pass --name with a plain directory name" % name)
    return name


def memory_link_state(path: Path, expected: Path) -> str:
    """absent, real, expected (a link to `expected`) or other (any other link, dangling included)."""
    if path.is_symlink():
        target = Path(os.readlink(str(path)))
        if not target.is_absolute():
            target = path.parent / target
        return "expected" if os.path.realpath(str(target)) == os.path.realpath(str(expected)) else "other"
    return "real" if path.exists() else "absent"


def memory_excludes(main: Path) -> Path:
    out = memory_git(main, "rev-parse", "--git-path", "info/exclude")
    if not out or not out.strip():
        raise DeployError("cannot find info/exclude of %s" % main)
    return (main / out.strip()).resolve()


def memory_exclude_lines(path: Path) -> List[str]:
    try:
        return [ln.strip() for ln in path.read_text(encoding="utf-8").splitlines()]
    except OSError:
        return []


def memory_append_lines(path: Path, lines: List[str]) -> None:
    """Append `lines` to the text file `path`, creating it (and its directory) when absent."""
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    path.write_text(text + "".join(ln + "\n" for ln in lines), encoding="utf-8")


def memory_readme(toplevel: Path, external: Path) -> str:
    origin = git_remote(toplevel) or "none"
    restore = "\n".join("    mv %s %s" % (sh_quote(str(external / n)), sh_quote(str(toplevel / n)))
                        for n, _ in MEMORY_ITEMS)
    return ("%s\n\n# Project memory\n\n"
            "This directory holds the `.supervisor/` store and `CLAUDE.local.md` of one project. The project "
            "checkout links to them and excludes the links through `.git/info/exclude`. Manage them with "
            "`claude-supervisor memory`.\n\n"
            "project: %s\norigin: %s\n\n"
            "To move the memory back into the project, remove the two links there, then run:\n\n%s\n"
            % (MEMORY_MARKER, toplevel, origin, restore))


def memory_attach(toplevel: Path, external: Path, template: Path) -> None:
    """Shared tail of externalize and link: excludes, external README, .gitignore, store README."""
    exclude = memory_excludes(toplevel)
    have = memory_exclude_lines(exclude)
    missing = [ln for ln in MEMORY_EXCLUDES if ln not in have]
    if missing:
        memory_append_lines(exclude, missing)
        for ln in missing:
            print("excluded: %s in %s" % (ln, exclude))
    readme = external / "README.md"
    want = memory_readme(toplevel, external)
    old = readme.read_text(encoding="utf-8") if readme.exists() else None
    if old != want:
        readme.write_text(want, encoding="utf-8")
        print("%s README.md: %s" % ("created" if old is None else "refreshed", readme))
    ignore = external / ".gitignore"
    if RESIDUE_IGNORE not in memory_exclude_lines(ignore):
        memory_append_lines(ignore, [RESIDUE_IGNORE])
        print("ignored: %s in %s" % (RESIDUE_IGNORE, ignore))
    store_readme = external / ".supervisor" / "README.md"
    text = template.read_text(encoding="utf-8")
    if not store_readme.exists() or store_readme.read_text(encoding="utf-8") != text:
        store_readme.write_text(text, encoding="utf-8")
        print("refreshed README: %s" % store_readme)


def memory_prepare(args: argparse.Namespace, verb: str) -> Tuple[Path, Path, Path, Path]:
    """Checks shared by both writing verbs; returns (main toplevel, project toplevel, external dir, template)."""
    if os.name != "posix":
        raise DeployError("memory needs a POSIX system (symlinks); this platform is not supported")
    template = resolve_target(args).joinpath(*MEMORY_TEMPLATE)
    main, wt = memory_project(Path.cwd())
    top = wt or main
    if verb == "externalize" and wt:
        raise DeployError("externalize runs in the main checkout (%s); run `claude-supervisor memory link` "
                          "in this worktree" % main)
    if not template.is_file():
        raise DeployError("%s is missing; install the pack first (./deploy install)" % template)
    if getattr(args, "dir", None):
        external = Path(args.dir).expanduser().resolve()
    else:
        external = (memory_root(args) / memory_name(main, args.name)).resolve()
    for name, _ in MEMORY_ITEMS:
        if memory_git(top, "ls-files", "--error-unmatch", "--", name) is not None:
            raise DeployError("%s is tracked by git; untrack it first: git rm -r --cached %s "
                              "(then commit)" % (name, name))
    checkouts = [main, top]
    listing = memory_git(main, "worktree", "list", "--porcelain") or ""
    checkouts += [Path(ln[len("worktree "):]).resolve() for ln in listing.splitlines() if ln.startswith("worktree ")]
    for co in checkouts:
        if external == co or co in external.parents:
            raise DeployError("%s lies inside the checkout %s; use a directory outside every checkout of "
                              "this repo (--root or --name)" % (external, co))
    return main, top, external, template


def memory_foreign_readme(external: Path) -> None:
    readme = external / "README.md"
    if readme.exists():
        with open(str(readme), encoding="utf-8", errors="replace") as f:
            first = f.readline().rstrip("\n")
        if first != MEMORY_MARKER:
            raise DeployError("%s exists and is not written by claude-supervisor (its first line is not "
                              "the marker); move it away or pick another --root or --name" % readme)


def memory_externalize_cmd(args: argparse.Namespace) -> int:
    """Move (or create) the project's .supervisor and CLAUDE.local.md in an external directory and link them."""
    main, top, external, template = memory_prepare(args, "externalize")
    plan = []  # (name, is_dir, action)
    for name, is_dir in MEMORY_ITEMS:
        proj, ext = top / name, external / name
        state = memory_link_state(proj, ext)
        present = ext.exists() or ext.is_symlink()
        if state == "expected":
            action = "keep"
        elif state == "other":
            raise DeployError("%s is a link to %s, not to %s; remove the link or pick another --root or --name"
                              % (proj, os.readlink(str(proj)), ext))
        elif state == "real":
            if present:
                raise DeployError("both exist: %s and %s; move or remove one of them, then re-run"
                                  % (proj, ext))
            action = "move"
        elif present:
            raise DeployError("%s exists in %s but not in the project; run `claude-supervisor memory link` "
                              "to attach it (or pick another --name if it belongs to another project)"
                              % (name, external))
        else:
            action = "create"
        plan.append((name, is_dir, action))
    memory_foreign_readme(external)
    external.mkdir(parents=True, exist_ok=True)
    for name, is_dir, action in plan:
        proj, ext = top / name, external / name
        if action == "move":
            shutil.move(str(proj), str(ext))
            print("moved: %s -> %s" % (proj, ext))
        elif action == "create":
            if is_dir:
                ext.mkdir()
            else:
                ext.touch()
            print("created: %s" % ext)
        if action != "keep":
            os.symlink(str(ext), str(proj))
            print("linked: %s -> %s" % (proj, ext))
    memory_attach(main, external, template)
    print("externalized: %s" % external)
    return 0


def memory_link_cmd(args: argparse.Namespace) -> int:
    """Link the project's .supervisor and CLAUDE.local.md to an existing external directory."""
    main, top, external, template = memory_prepare(args, "link")
    if not (external / ".supervisor").is_dir():
        raise DeployError("no external store at %s (no .supervisor there); run `claude-supervisor memory "
                          "externalize` in the main checkout first, or pass the directory" % external)
    plan = []
    for name, is_dir in MEMORY_ITEMS:
        proj, ext = top / name, external / name
        state = memory_link_state(proj, ext)
        present = ext.exists() or ext.is_symlink()
        if state == "real":
            raise DeployError("%s is a real file in the project; run `claude-supervisor memory externalize` "
                              "to move it, or remove it first" % proj)
        if state == "other":
            raise DeployError("%s is a link to %s (%s), not to %s; remove the link, then re-run"
                              % (proj, os.readlink(str(proj)), "exists" if proj.exists() else "dangling", ext))
        plan.append((name, state == "absent", present))
    memory_foreign_readme(external)
    for name, absent, present in plan:
        if not absent:
            continue
        proj, ext = top / name, external / name
        if not present:
            ext.touch()
            print("created: %s" % ext)
        os.symlink(str(ext), str(proj))
        print("linked: %s -> %s" % (proj, ext))
    memory_attach(main, external, template)
    print("linked: %s" % external)
    return 0


def memory_status_cmd(args: argparse.Namespace) -> int:
    """Check the two links and the exclude lines; exit 1 with a repair hint when anything is off."""
    if os.name != "posix":
        raise DeployError("memory needs a POSIX system (symlinks); this platform is not supported")
    main, wt = memory_project(Path.cwd())
    top = wt or main
    problems = []
    sup = top / ".supervisor"
    external = None  # the directory the project's .supervisor link names
    if sup.is_symlink():
        external = Path(os.path.normpath(str(top / os.readlink(str(sup))))).parent
    for name, _ in MEMORY_ITEMS:
        path = top / name
        if path.is_symlink():
            if not path.exists():
                problems.append("%s: dangling link to %s; restore the external directory or remove the link and "
                                "run `claude-supervisor memory link`" % (name, os.readlink(str(path))))
            elif external is not None and memory_link_state(path, external / name) != "expected":
                problems.append("%s: links to %s, not %s; remove it and run `claude-supervisor memory link`"
                                % (name, os.readlink(str(path)), external / name))
        elif path.exists():
            problems.append("%s: a real file, not externalized; run `claude-supervisor memory externalize`" % name)
        else:
            problems.append("%s: missing; run `claude-supervisor memory link` (or `externalize`)" % name)
    have = memory_exclude_lines(memory_excludes(main))
    for line in MEMORY_EXCLUDES:
        if line not in have:
            problems.append("missing %s in info/exclude; run `claude-supervisor memory link` to add it" % line)
    for p in problems:
        print(p)
    if problems:
        return 1
    print("ok: %s -> %s" % (top, external))
    return 0


def build_parser(launcher_tag: Optional[str] = None) -> argparse.ArgumentParser:
    """The deploy CLI; with launcher_tag, the subset a claude-TAG launcher runs, fixed to that install."""
    if launcher_tag:
        p = argparse.ArgumentParser(prog="claude-" + launcher_tag,
                                    epilog="Acts on this install only; run ./deploy from your checkout for others.")
    else:
        p = argparse.ArgumentParser(
            prog="deploy",
            description="Install, inspect and remove the Supervisor for Claude pack in a Claude Code config dir.",
            epilog="Target: profile ~/.config/claude-TAG (--tag, default supervisor; --target DIR sets the dir), "
                   "or --global for ~/.claude.")
        p.add_argument("--version", action=VersionAction, help="show the pack version and the claude version")
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    sub.required = True

    PREFIX_HELP = ("launchers in DIR/bin, registry and tool copy in DIR/state/claude-supervisor "
                   "(default: ~/.local)")

    def common(sp: argparse.ArgumentParser, source: bool = True) -> None:
        if launcher_tag:
            return
        sp.add_argument("--tag", help="profile tag: launcher claude-TAG (default: supervisor)")
        sp.add_argument("--target", metavar="DIR", help="profile dir (default: ~/.config/claude-TAG)")
        sp.add_argument("--global", dest="use_global", action="store_true",
                        help="use ~/.claude (no seeding, no launcher)")
        sp.add_argument("--prefix", metavar="DIR", help=PREFIX_HELP)
        if source:
            sp.add_argument("--source", metavar="DIR", help="pack dir (default: <repo>/pack)")

    def add_parser(name: str, **kwargs) -> argparse.ArgumentParser:
        if launcher_tag and name not in LAUNCHER_COMMANDS:
            return argparse.ArgumentParser(add_help=False)  # not reachable from a launcher
        return sub.add_parser(name, **kwargs)

    sp = add_parser("install", help="install or update the pack (idempotent)",
                        description="Copy agents and skills into the target, reconcile against the manifest, "
                                    "and set settings.json agent = supervisor.")
    common(sp)
    sp.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    sp.add_argument("--yes", "-y", action="store_true",
                    help="do not prompt (answers yes to --overwrite-local)")
    sp.add_argument("--overwrite-local", action="store_true",
                    help="back up and replace locally modified or unmanaged files")
    g = sp.add_mutually_exclusive_group()
    g.add_argument("--no-default-agent", action="store_true", help="do not set settings.json agent")
    g.add_argument("--force-default-agent", action="store_true",
                   help="replace an existing different settings.json agent value")
    sp.add_argument("--provider", metavar="NAME",
                    help="profile: API provider preset openrouter, nrp or alcf (base URL, auth, model list; '' clears)")
    sp.add_argument("--base-url", metavar="URL",
                    help="profile: export ANTHROPIC_BASE_URL; with --provider, replaces its URL ('' clears the provider)")
    tok = sp.add_mutually_exclusive_group()
    tok.add_argument("--token-file", metavar="PATH", help="profile: copy to <dir>/token for ANTHROPIC_AUTH_TOKEN")
    tok.add_argument("--token", metavar="VALUE", help="like --token-file, from a value (stays in shell history)")
    tok.add_argument("--token-helper", metavar="CMD",
                     help="profile: settings.json apiKeyHelper command that prints an expiring token")
    for tier in TIERS:
        sp.add_argument("--model-" + tier, metavar="ID",
                        help="profile: provider model for the %s tier (default: pick from a list)" % tier.capitalize())
    sp.set_defaults(func=install_cmd)

    sp = add_parser("status", help="show installed files and their state",
                        description="Show manifest info and per-file state (ok/modified/missing/outdated).")
    common(sp)
    sp.set_defaults(func=status_cmd)

    sp = add_parser("list", help="list every registered install",
                        description="Show each registered install with its pack version, branch, commit and launcher.")
    if not launcher_tag:
        sp.add_argument("--prefix", metavar="DIR", help=PREFIX_HELP)
    sp.set_defaults(func=list_cmd)

    sp = add_parser("uninstall", help="remove the pack",
                        description="Remove unmodified managed files, restore settings agent, delete the manifest. "
                                    "Locally modified files are kept unless --force. Profile installs (default): deletes the "
                                    "whole profile dir and its launcher. --global: removes only pack files.")
    common(sp, source=False)
    sp.add_argument("--dry-run", action="store_true", help="show what would be removed; write nothing")
    sp.add_argument("--yes", "-y", action="store_true", help="do not prompt")
    sp.add_argument("--force", action="store_true", help="also remove locally modified managed files")
    sp.add_argument("--all", action="store_true", help="uninstall every registered install")
    sp.add_argument("--launcher", action="store_true", help=argparse.SUPPRESS)
    sp.set_defaults(func=uninstall_cmd)

    sp = add_parser("update", help="update registered installs from the git remote",
                        description="Shallow-clone the branch recorded at install time (main if none) from the "
                                    "recorded remote and re-run install from that clone with each install's "
                                    "recorded options. Exits 3 when that branch is gone from the remote.")
    common(sp, source=False)
    sp.add_argument("--all", action="store_true", help="update every registered install")
    sp.add_argument("--from", dest="from_dir", metavar="DIR",
                    help="repo checkout to install from instead of cloning the recorded remote")
    sp.add_argument("--yes", "-y", action="store_true", help="do not prompt (--all asks once)")
    sp.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    sp.add_argument("--launcher", action="store_true", help=argparse.SUPPRESS)
    sp.set_defaults(func=update_cmd)

    sp = add_parser("migrate", help="move a pack installed in ~/.claude to the default profile",
                        description="Remove the pack from ~/.claude (settings.json and edited files are backed "
                                    "up first), install the default profile and its launcher, and check that "
                                    "DIR/bin is on PATH.")
    sp.add_argument("--prefix", metavar="DIR", help=PREFIX_HELP)
    sp.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    sp.add_argument("--yes", "-y", action="store_true", help="do not prompt")
    sp.set_defaults(func=migrate_cmd)

    sp = add_parser("doctor", help="check the environment and the install",
                        description="Print PASS/WARN/FAIL checks. Exits 1 if any check FAILs.")
    common(sp, source=False)
    sp.set_defaults(func=doctor_cmd)

    sp = add_parser("memory", help="keep a project's memory store outside its checkout",
                        description="Move .supervisor and CLAUDE.local.md to an external directory and link them "
                                    "back (externalize), attach a linked worktree or fresh machine to an existing "
                                    "external directory (link), or check the links (status).")
    common(sp, source=False)
    vsub = sp.add_subparsers(dest="verb", metavar="VERB", required=True)
    for verb, vhelp, func in (("externalize", "move or create the store in an external directory and link it",
                               memory_externalize_cmd),
                              ("link", "link the project to an existing external store", memory_link_cmd),
                              ("status", "check the links and exclude lines (exit 1 when broken)",
                               memory_status_cmd)):
        vp = vsub.add_parser(verb, help=vhelp, description=vhelp[0].upper() + vhelp[1:] + ".")
        if verb != "status":
            vp.add_argument("--root", metavar="DIR",
                            help="memory root (default: $CLAUDE_SUPERVISOR_MEMORY_ROOT, else "
                                 "${XDG_DATA_HOME:-~/.local/share}/claude-supervisor/memory)")
            vp.add_argument("--name", metavar="NAME", help="project directory under the root (default: origin basename)")
        if verb == "link":
            vp.add_argument("dir", nargs="?", help="external directory to link (ignores --root and --name)")
        vp.set_defaults(func=func)

    sp = add_parser("critic", help="switch the lead's critic to Codex",
                        description="Run the installed codex-critic script: enable [MODEL] [--yes], disable [--yes], status. "
                                    "Options after the verb that deploy does not own go to the script.")
    common(sp, source=False)
    sp.add_argument("verb", choices=("enable", "disable", "status"))
    sp.add_argument("rest", nargs=argparse.REMAINDER, help="arguments for the script (MODEL, --yes)")
    sp.set_defaults(func=critic_cmd)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    fixed = None
    if argv[:1] == ["--launcher"] and len(argv) >= 4:  # claude-TAG: --launcher PREFIX TAG TARGET COMMAND ...
        fixed, argv = argv[1:4], argv[4:]
        own = [a for a in argv if a.split("=")[0] in ("--tag", "--target", "--prefix", "--global")]
        if own:
            eprint("claude-%s: %s is fixed by this launcher; run ./deploy from your checkout "
                   "to act on another install" % (fixed[1], own[0].split("=")[0]))
            return 2
    args = build_parser(fixed[1] if fixed else None).parse_args(argv)
    if fixed:
        args.prefix, args.tag, args.target = fixed
        args.use_global, args.source, args.launcher = False, None, True
    try:
        return args.func(args)
    except DeployError as exc:
        eprint("error: %s" % exc)
        return 2
    except (OSError, shutil.Error) as exc:
        eprint("error: %s; check the path and permissions, then re-run" % exc)
        return 2
    except EOFError:
        eprint("aborted")
        return 1
    except KeyboardInterrupt:
        eprint("interrupted; re-run ./deploy install (use --overwrite-local if files are reported as not managed)")
        return 130


if __name__ == "__main__":
    sys.exit(main())
